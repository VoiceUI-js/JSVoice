{
  "name": "jsvoice",
  "version": "1.1.0",
  "description": "Voice commands for the web. Default: on-device Whisper tiny (any browser; peer @xenova/transformers). Use createVoice(). AI agents: read AGENTS.md + docs/AI_IMPLEMENTATION.md. Optional Web Speech, React kit, wake word. TypeScript ready.",
  "main": "dist/voice-ui.cjs.js",
  "module": "dist/voice-ui.esm.js",
  "unpkg": "dist/voice-ui.umd.min.js",
  "browser": "dist/voice-ui.umd.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/voice-ui.esm.js",
      "require": "./dist/voice-ui.cjs.js",
      "types": "./src/index.d.ts",
      "default": "./dist/voice-ui.esm.js"
    },
    "./src": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./core": {
      "import": "./src/JSVoice.js",
      "types": "./src/index.d.ts"
    },
    "./engines/native": {
      "import": "./src/engines/NativeSpeechEngine.js",
      "types": "./src/index.d.ts"
    },
    "./engines/whisper": {
      "import": "./src/engines/WhisperSpeechEngine.js",
      "types": "./src/index.d.ts"
    },
    "./engines/local": {
      "import": "./src/engines/LocalTransformersSpeechEngine.js",
      "types": "./src/index.d.ts"
    },
    "./engines/hybrid": {
      "import": "./src/engines/HybridSpeechEngine.js",
      "types": "./src/index.d.ts"
    },
    "./engines/porcupine-wake": {
      "import": "./dist/engines/PorcupineWakeAdapter.esm.js",
      "require": "./dist/engines/PorcupineWakeAdapter.cjs.js",
      "default": "./src/engines/PorcupineWakeAdapter.js"
    },
    "./plugins/visualizer": {
      "import": "./src/modules/AudioVisualizer.js",
      "types": "./src/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.esm.js",
      "require": "./dist/react/index.cjs.js",
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    },
    "./react/components": {
      "import": "./src/react/components.js"
    },
    "./react/kit": {
      "import": "./dist/react/kit/index.esm.js",
      "require": "./dist/react/kit/index.cjs.js",
      "types": "./src/react/kit/index.d.ts",
      "default": "./src/react/kit/index.js"
    },
    "./react/kit/store": {
      "import": "./src/react/kit/store.js"
    },
    "./react/kit/components": {
      "import": "./src/react/kit/components.js",
      "types": "./src/react/kit/components.d.ts"
    },
    "./react/kit/themes": {
      "import": "./src/react/kit/themes/index.js"
    },
    "./react/kit/widgets": {
      "import": "./src/react/kit/widgets.js"
    },
    "./react/kit/workflows": {
      "import": "./src/react/kit/workflows.js"
    },
    "./react/kit/debug": {
      "import": "./src/react/kit/debug.js"
    },
    "./react/kit/assistant": {
      "import": "./src/react/kit/assistant.js"
    },
    "./packs/kit": {
      "import": "./src/packs/kit.js"
    },
    "./plugins/kit": {
      "import": "./src/plugins/kit/index.js",
      "types": "./src/plugins/kit/index.d.ts"
    },
    "./packs/basic": {
      "import": "./src/packs/basic.js"
    },
    "./ui-kit": {
      "import": "./dist/ui-kit/index.esm.js",
      "require": "./dist/ui-kit/index.cjs.js",
      "types": "./src/ui-kit/index.d.ts",
      "default": "./src/ui-kit/index.js"
    },
    "./ui-kit/core/store": {
      "import": "./src/ui-kit/core/store.js",
      "types": "./src/ui-kit/core/store.d.ts"
    },
    "./ui-kit/core/useUiKitState": {
      "import": "./src/ui-kit/core/useUiKitState.js"
    },
    "./ui-kit/core/controller": {
      "import": "./src/ui-kit/core/controller.js",
      "types": "./src/ui-kit/core/controller.d.ts"
    },
    "./ui-kit/modules/widgets": {
      "import": "./src/ui-kit/modules/widgets/index.js"
    },
    "./ui-kit/modules/widgets/components": {
      "import": "./src/ui-kit/modules/widgets/components.js"
    },
    "./ui-kit/modules/rules": {
      "import": "./src/ui-kit/modules/rules/index.js"
    },
    "./ui-kit/modules/links": {
      "import": "./src/ui-kit/modules/links/index.js"
    },
    "./ui-kit/modules/constraints": {
      "import": "./src/ui-kit/modules/constraints/index.js"
    },
    "./ui-kit/modules/bookmarks": {
      "import": "./src/ui-kit/modules/bookmarks/index.js"
    },
    "./ui-kit/modules/summaries": {
      "import": "./src/ui-kit/modules/summaries/index.js"
    },
    "./ui-kit/modules/voice-mode": {
      "import": "./src/ui-kit/modules/voice-mode/index.js"
    },
    "./ui-kit/modules/voice-mode/components": {
      "import": "./src/ui-kit/modules/voice-mode/components.js"
    },
    "./ui-kit/modules/undo": {
      "import": "./src/ui-kit/modules/undo/index.js"
    },
    "./ui-kit/modules/repair": {
      "import": "./src/ui-kit/modules/repair/index.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"examples/**/*.{html,js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "prepare": "npm run build"
  },
  "files": [
    "dist/",
    "src/",
    "examples/",
    "AGENTS.md",
    "llms.txt",
    "docs/AI_IMPLEMENTATION.md",
    "docs/LOCAL_BROWSER_WHISPER.md",
    "docs/SECURITY_AND_PRIVACY.md",
    "docs/USER_GUIDE.md",
    "docs/API_REFERENCE.md",
    "docs/README.md",
    "docs/HYPER_VOICE_MIGRATION.md",
    "docs/HYPER_VOICE_UI_KIT.md",
    "DOCUMENTATION.md",
    "DETAILED_DOCUMENTATION.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "voice",
    "voice-commands",
    "voice-control",
    "voice-recognition",
    "speech",
    "speech-recognition",
    "speech-synthesis",
    "text-to-speech",
    "tts",
    "stt",
    "web-speech-api",
    "voice-ui",
    "voice-interface",
    "accessibility",
    "a11y",
    "hands-free",
    "wake-word",
    "pattern-matching",
    "audio-visualization",
    "waveform",
    "amplitude",
    "javascript",
    "typescript",
    "browser",
    "web",
    "frontend",
    "ui",
    "ux",
    "pwa",
    "progressive-web-app",
    "whisper",
    "transformers.js",
    "offline-speech",
    "on-device",
    "lightweight"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoiceUI-js/VoiceUI.git"
  },
  "homepage": "https://github.com/VoiceUI-js/VoiceUI#readme",
  "bugs": {
    "url": "https://github.com/VoiceUI-js/VoiceUI/issues"
  },
  "author": "JSVoice Contributors",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "@picovoice/porcupine-web": ">=3",
    "@picovoice/web-voice-processor": ">=4",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@picovoice/porcupine-web": {
      "optional": true
    },
    "@picovoice/web-voice-processor": {
      "optional": true
    },
    "@xenova/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.28.3",
    "@playwright/test": "^1.49.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@xenova/transformers": "^2.17.2",
    "babel-jest": "^30.1.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.9.6",
    "serve": "^14.2.4",
    "storybook": "^8.4.7",
    "vite": "^5.4.11"
  }
}